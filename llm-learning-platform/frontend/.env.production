# Frontend Environment Variables - Production
# These values are used for Vercel deployment

# Backend API URL (your local backend)
NEXT_PUBLIC_API_URL=http://172.20.10.5:8000

# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://172.20.10.5:8000

# API Key (default dev key - change in production)
NEXT_PUBLIC_API_KEY=llm_dev_admin_key_change_in_production

# Environment
NODE_ENV=production
