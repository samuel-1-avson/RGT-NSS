# Frontend Environment Variables - Development
# This file is not committed to git (see .gitignore)

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# API Key for development (default dev key)
NEXT_PUBLIC_API_KEY=llm_dev_admin_key_change_in_production

# Environment
NODE_ENV=development
