{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/learn", "destination": "/learn/index.html" },
    { "source": "/learn/(.*)", "destination": "/learn/$1/index.html" },
    { "source": "/train", "destination": "/train/index.html" },
    { "source": "/models", "destination": "/models/index.html" },
    { "source": "/inference", "destination": "/inference/index.html" }
  ]
}
