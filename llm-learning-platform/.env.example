# ──────────────────────────────────────────────────────────────
# Interactive LLM Learning Platform - Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────

# ─── Environment ─────────────────────────────────────────────
ENVIRONMENT=development        # development | staging | production

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://llmuser:llmpass@postgres:5432/llmplatform
POSTGRES_USER=llmuser
POSTGRES_PASSWORD=llmpass
POSTGRES_DB=llmplatform

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── CORS ────────────────────────────────────────────────────
# In production, set to your Vercel frontend URL
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ─── GPU ─────────────────────────────────────────────────────
USE_GPU=false
CUDA_VISIBLE_DEVICES=0

# ─── API ─────────────────────────────────────────────────────
APP_NAME=LLM Learning Platform
APP_VERSION=3.0.0
LOG_LEVEL=info

# ─── Frontend (set in Vercel Dashboard for production) ───────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
