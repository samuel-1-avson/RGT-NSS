# ──────────────────────────────────────────────────────────────
# Interactive LLM Learning Platform - Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────

# ─── Environment ─────────────────────────────────────────────
ENVIRONMENT=development        # development | staging | production

# ─── Security ────────────────────────────────────────────────
# IMPORTANT: Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-random-key

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://llmuser:your-db-password@postgres:5432/llmplatform
POSTGRES_USER=llmuser
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=llmplatform

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── CORS ────────────────────────────────────────────────────
# In production, set to your frontend
CORS_ORIGINS=${CORS_ORIGINS:-["http://localhost:3000","http://localhost:8000"]}

# ─── GPU ─────────────────────────────────────────────────────
USE_GPU=false
CUDA_VISIBLE_DEVICES=0

# ─── API ─────────────────────────────────────────────────────
APP_NAME=LLM Learning Platform
APP_VERSION=3.0.0
LOG_LEVEL=info

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
